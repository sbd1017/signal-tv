# /etc/systemd/system/signal-tv-alert@.service - Telegram alert when a TV unit fails, and a
# "resolved" note when it next succeeds (only if an alert had gone out). Started by OnFailure= /
# OnSuccess= in signal-tv.service, signal-tv-backup.service, signal-tv-backup-upload.service
# as signal-tv-alert@failed:<unit>.service / @ok:<unit>.service. Rules: tvapp/alerts.py
# (dedup + backoff, redaction). Credentials: /etc/signal-tv/telegram.env (absent = alerts off).
[Unit]
Description=Signal TV alert (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=signal-tv
Group=signal-tv
WorkingDirectory=/opt/signal-tv
Environment=PYTHONDONTWRITEBYTECODE=1 TV_STATE_DIR=/var/lib/signal-tv
ExecStart=/opt/signal-tv/venv/bin/python -m tvapp.alerts %i
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signal-tv
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

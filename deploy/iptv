#!/bin/bash
# iptv - manage Signal TV (https://example.com/tv) on this Pi.
# Secrets are always read with a hidden prompt and passed on stdin (never argv).
set -euo pipefail

SERVICE=signal-tv
DEMO=signal-tv-demo
ENV_FILE=/etc/signal-tv/tv.env
PY=/opt/signal-tv/venv/bin/python
API=http://127.0.0.1:8790/tv/api
DEMO_URL=http://127.0.0.1:8791
FAMILY=/etc/signal-tv-family
# `iptv family NAME <command>` runs <command> against that family site (deploy/family.sh)
SITE=${IPTV_SITE:-}
if [ -n "$SITE" ]; then
  [ -f "$FAMILY/$SITE.site" ] || { echo "no family site called $SITE (iptv family)"; exit 1; }
  SERVICE="signal-tv-family@$SITE"
  ENV_FILE="$FAMILY/$SITE.env"
  API="http://127.0.0.1:$(sed -n 's/^TV_PORT=//p' "$FAMILY/$SITE.site")/tv/api"
fi

helper() { sudo env TV_CONFIG="$ENV_FILE" "$PY" -c 'import sys; sys.path.insert(0, "/opt/signal-tv"); from tvapp.cli import main; sys.argv[0] = "iptv"; sys.exit(main())' "$@"; }
setval() { printf '%s\n' "$2" | helper set "$1"; }
ask() {  # ask VAR "Prompt" [secret]
  local __v
  if [ "${3:-}" = secret ]; then read -r -s -p "$2: " __v; echo; else read -r -p "$2: " __v; fi
  printf -v "$1" '%s' "$__v"
}
valid_url() { printf '%s\n' "$1" | helper check-url; }
reload_app() {
  if systemctl is-active --quiet "$SERVICE"; then
    sudo systemctl reload "$SERVICE" && echo "Reloaded: catalogue and guide are refreshing (iptv status to watch)."
  else
    echo "Service is not running - start it with: iptv start"
  fi
}
upload_status() {
  local res at
  res=$(systemctl show -p Result --value signal-tv-backup-upload.service)
  at=$(systemctl show -p ExecMainExitTimestamp --value signal-tv-backup-upload.service)
  if [ -z "$at" ]; then echo "Google Drive upload: not run yet"
  elif [ "$res" = success ]; then echo "Google Drive upload: OK ($at)"
  else echo "Google Drive upload: FAILED ($at) - NEEDS ATTENTION: journalctl -u signal-tv-backup-upload -n 20"
       echo "                     ('invalid_grant' = Google sign-in expired: README > System backups)"; fi
}
warn_argv() { echo "note: values given on the command line end up in your shell history; run without it to be prompted." >&2; }

usage() {
  cat <<'USAGE'
iptv - manage Signal TV (https://example.com/tv)

  iptv status              service state, provider, catalogue/guide counts, active streams
  iptv show-config         current settings (URLs and credentials masked)
  iptv config              edit /etc/signal-tv/tv.env (sudoedit), then reload
  iptv set-provider m3u|xtream
  iptv set-playlist        prompt for the M3U/M3U8 URL (hidden), switch to m3u, reload
  iptv set-epg             prompt for the XMLTV guide URL (hidden; empty = none), reload
  iptv set-xtream          prompt for Xtream server URL, username, password, switch to xtream, reload
  iptv use-demo            point at the built-in demo provider (legal test streams), reload
  iptv demo on|off         start+enable / stop+disable the demo provider service
  iptv refresh             refresh catalogue + guide now (same as reload)
  iptv refresh --accept-changes   refresh and accept the result even if it looks wrong (after a rejected refresh)
  iptv alert-test          send a test Telegram alert
  iptv reload              re-read tv.env and refresh, without dropping the service
  iptv restart             restart the service (stops all streams)
  iptv start | stop        start / stop the service
  iptv logs [-f] [N]       last N (default 100) log lines; -f to follow
  iptv jobs                active stream jobs (ffmpeg)
  iptv revoke-sessions     sign out every remembered browser/home-screen app
  iptv family              the family sites (other households' copies at example.com/<name>)
  iptv family add NAME     create example.com/NAME (its own service, provider, passphrase)
  iptv family remove NAME  take it down for good (asks you to type its name)
  iptv family NAME passphrase | signout   set its passphrase (prompted) / sign every device out
  iptv family NAME status | set-xtream | set-playlist | use-demo | config | logs | restart …
                           any of the provider and service commands above, for that site
  iptv backup              back up synced state + config + code now (also runs daily; user data then goes to Google Drive)
  iptv backups             list backups and the last Google Drive upload
  iptv ui [status|new|classic]  default interface for devices that haven't chosen one in Settings
  iptv artwork missing [--teams|--competitions] [--most-seen|--recent] [--resolved|--all] [--json]
                           sports crests/logos (/tv-test library): coverage, gaps seen on screen, guide names with no entry
USAGE
}

cmd=${1:-help}; shift || true
if [ -n "$SITE" ]; then
  case "$cmd" in
    status|show-config|config|set-provider|set-playlist|set-epg|set-xtream|use-demo|refresh|reload|restart|start|stop|logs|jobs) ;;
    *) echo "iptv family $SITE: '$cmd' is for the main site only"; exit 2 ;;
  esac
fi
case "$cmd" in
  family)
    sub=${1:-list}; shift || true
    case "$sub" in
      list|add|build|restart) /opt/signal-tv/deploy/family.sh "$sub" "$@" ;;
      remove)
        read -r -p "Remove /${1:-?} for good, with its favourites, history and provider settings? Type its name to confirm: " ok
        [ "$ok" = "${1:-}" ] || { echo "Not removed."; exit 1; }
        /opt/signal-tv/deploy/family.sh remove "$1" ;;
      *)
        name=$sub; action=${1:-status}; shift || true
        [ -f "$FAMILY/$name.site" ] || { echo "no family site called $name (iptv family)"; exit 1; }
        case "$action" in
          passphrase)
            ask p1 "New passphrase for /$name (input hidden; at least 6 characters)" secret
            ask p2 "Again" secret
            [ "$p1" = "$p2" ] || { echo "They don't match."; exit 1; }
            printf '%s\n' "$p1" | sudo -u signal-tv env TV_STATE_DIR=/var/lib/signal-tv PYTHONPATH=/opt/signal-tv "$PY" -m tvapp.family passphrase "$name"
            unset p1 p2 ;;
          signout|clear) sudo -u signal-tv env TV_STATE_DIR=/var/lib/signal-tv PYTHONPATH=/opt/signal-tv "$PY" -m tvapp.family "$action" "$name" ;;
          *) IPTV_SITE="$name" exec "$0" "$action" "$@" ;;
        esac ;;
    esac ;;
  status)
    systemctl --no-pager --lines=0 status "$SERVICE" | sed -n '1,4p' || true
    systemctl is-active --quiet "$DEMO" && echo "demo provider: running" || echo "demo provider: stopped"
    if out=$(curl -fsS --max-time 5 "$API/status" 2>/dev/null); then
      printf '%s' "$out" | "$PY" -c 'import sys; sys.path.insert(0, "/opt/signal-tv"); from tvapp.cli import main; sys.argv[0] = "iptv"; sys.exit(main())' format-status
    else
      echo "API not answering on ${API%/tv/api}"
    fi
    last=$(ls -t /var/backups/signal-tv/signal-tv-*.tar.gz 2>/dev/null | head -1)
    echo "backups:       ${last:-none yet}"
    upload_status ;;
  show-config) helper show ;;
  config)
    sudoedit "$ENV_FILE"
    sudo chown root:signal-tv "$ENV_FILE"; sudo chmod 0640 "$ENV_FILE"
    reload_app ;;
  set-provider)
    p=${1:-}; [[ "$p" == m3u || "$p" == xtream ]] || { echo "usage: iptv set-provider m3u|xtream"; exit 2; }
    setval IPTV_PROVIDER_TYPE "$p"; reload_app ;;
  set-playlist)
    if [ $# -ge 1 ]; then warn_argv; url=$1; else ask url "M3U/M3U8 playlist URL (input hidden)" secret; fi
    valid_url "$url" || { echo "That is not an http(s) URL."; exit 1; }
    setval IPTV_M3U_URL "$url"; setval IPTV_PROVIDER_TYPE m3u; unset url
    reload_app ;;
  set-epg)
    if [ $# -ge 1 ]; then warn_argv; url=$1; else ask url "XMLTV guide URL, .xml or .xml.gz (input hidden; empty = none)" secret; fi
    if [ -n "$url" ]; then valid_url "$url" || { echo "That is not an http(s) URL."; exit 1; }; fi
    setval IPTV_EPG_URL "$url"; unset url
    reload_app ;;
  set-xtream)
    ask base "Xtream server URL (e.g. http://host:8080)"
    valid_url "$base" || { echo "That is not an http(s) URL."; exit 1; }
    ask user "Username"
    ask pass "Password (input hidden)" secret
    [ -n "$user" ] && [ -n "$pass" ] || { echo "Username and password are required."; exit 1; }
    setval XTREAM_BASE_URL "${base%/}"; setval XTREAM_USERNAME "$user"; setval XTREAM_PASSWORD "$pass"
    setval IPTV_PROVIDER_TYPE xtream; unset pass
    echo "Saved. (Guide: leave IPTV_EPG_URL empty to use the panel's xmltv.php, or run iptv set-epg.)"
    reload_app ;;
  use-demo)
    sudo systemctl enable --now "$DEMO" >/dev/null
    setval IPTV_PROVIDER_TYPE m3u
    setval IPTV_M3U_URL "$DEMO_URL/playlist.m3u"
    setval IPTV_EPG_URL "$DEMO_URL/epg.xml.gz"
    reload_app ;;
  demo)
    case "${1:-}" in
      on) sudo systemctl enable --now "$DEMO" && echo "demo provider running on $DEMO_URL" ;;
      off) sudo systemctl disable --now "$DEMO" && echo "demo provider stopped" ;;
      *) echo "usage: iptv demo on|off"; exit 2 ;;
    esac ;;
  refresh)
    if [ "${1:-}" = --accept-changes ]; then
      curl -fsS --max-time 10 "$API/refresh?accept=1" >/dev/null && echo "The next catalogue refresh will be accepted even if it looks wrong; refreshing now (iptv status to watch)." || echo "API not answering"
    else reload_app; fi ;;
  reload) reload_app ;;
  alert-test) sudo -u signal-tv env TV_STATE_DIR=/var/lib/signal-tv "$PY" -c 'import sys; sys.path.insert(0, "/opt/signal-tv"); from tvapp.alerts import main; sys.exit(main(["test"]))' ;;
  restart) sudo systemctl restart "$SERVICE" && echo "restarted" ;;
  start) sudo systemctl start "$SERVICE" && echo "started" ;;
  stop) sudo systemctl stop "$SERVICE" && echo "stopped" ;;
  logs)
    follow=(); n=100
    for a in "$@"; do case "$a" in -f) follow=(-f) ;; *[!0-9]*) ;; *) n=$a ;; esac; done
    sudo journalctl -u "$SERVICE" -u "$DEMO" -n "$n" --no-pager -o short-iso "${follow[@]}" ;;
  jobs) curl -fsS --max-time 5 "$API/status" | python3 -c 'import json,sys; [print(j) for j in json.load(sys.stdin)["jobs"]] or None' ;;
  revoke-sessions)
    sudo rm -f /var/lib/signal-tv/secret.key
    sudo systemctl restart "$SERVICE"
    echo "All remembered sessions are signed out; browsers will ask for the site login again." ;;
  backup)
    sudo systemctl start signal-tv-backup.service
    f=$(sudo find /var/backups/signal-tv -maxdepth 1 -name 'signal-tv-*.tar.gz' -printf '%T@ %p\n' | sort -n | tail -1 | cut -d' ' -f2-)
    echo "Backup written: $f"
    echo "It contains the provider credentials (tv.env): keep copies private."
    sleep 1                                      # the Drive upload starts when the backup succeeds
    for _ in $(seq 1 120); do
      case $(systemctl show -p ActiveState --value signal-tv-backup-upload.service) in activating|active) sleep 1 ;; *) break ;; esac
    done
    upload_status ;;
  backups) sudo ls -lh /var/backups/signal-tv/ /var/backups/signal-tv/user-state/; upload_status ;;
  ui)
    case "${1:-status}" in
      status) /opt/signal-tv/deploy/ui-switch.sh status ;;
      new|classic|old) /opt/signal-tv/deploy/ui-switch.sh use "$1" ;;
      *) echo "usage: iptv ui [status|new|classic]"; exit 2 ;;
    esac ;;
  artwork)
    sub=${1:-missing}; shift || true
    [ "$sub" = missing ] || { echo "usage: iptv artwork missing [--teams|--competitions] [--most-seen|--recent] [--resolved|--all] [--json]"; exit 2; }
    q="format=text"
    for a in "$@"; do case "$a" in
      --teams) q+="&kind=team" ;; --competitions) q+="&kind=comp" ;;
      --recent) q+="&sort=recent" ;; --most-seen) q+="&sort=seen" ;;
      --resolved) q+="&state=resolved" ;; --all) q+="&state=all" ;; --open) q+="&state=open" ;;
      --json) q=${q/format=text/format=json} ;;
      *) echo "unknown option: $a"; exit 2 ;;
    esac; done
    curl -fsS --max-time 60 "http://127.0.0.1:8792/internal/missing?$q" \
      || { echo "The artwork service (signal-tv-next) is not answering on 127.0.0.1:8792."; exit 1; } ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
